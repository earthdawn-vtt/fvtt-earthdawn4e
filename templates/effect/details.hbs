<!-- from Foundry core's "templates/sheets/active-effect-config/details.hbs"-->
<section class="tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{formGroup systemFields.parentDocumentType value=document.system.parentDocumentType rootId=rootId}}

  {{#if document.targetsActor}}
    <fieldset>
    {{formGroup fields.statuses value=source.statuses options=statuses sort=true rootId=rootId classes="statuses"}}
    {{#if hasLevels}}
      {{{levelInput}}}
    {{/if}}
    </fieldset>
  {{/if}}

  {{formGroup systemFields.execution.fields.executable value=source.system.execution.executable rootId=rootId localize=true}}

  <fieldset>
    {{formGroup fields.tint value=source.tint rootId=rootId placeholder="#ffffff"}}
    {{formGroup fields.disabled value=source.disabled rootId=rootId readonly=disabledReadOnly
                hint=(ifThen disabledReadOnly tooltips.disabled "")
    }}

    {{formGroup fields.origin value=source.origin rootId=rootId}}
    {{#if (eq document.system.parentDocumentType "Item")}}
      {{formGroup systemFields.transferring.fields.transfer value=document.systemTransfer rootId=rootId }}
      {{#if document.systemTransfer}}
        {{formGroup systemFields.transferring.fields.target value=document.system.transferring.target rootId=rootId}}
        {{#if (eq document.system.transferring.target "ability")}}
          {{formGroup systemFields.transferring.fields.abilityEdid value=document.system.transferring.abilityEdid rootId=rootId}}
        {{/if}}
      {{/if}}
    {{/if}}

  </fieldset>

  {{formGroup fields.description value=source.description rootId=rootId}}
</section>