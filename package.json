{
  "name": "ed4e",
  "version": "0.2.0",
  "description": "An implementation of the ED4E game system for Foundry Virtual Tabletop (https://foundryvtt.com).",
  "author": "Patrick & Qrizzl & alegionofone & Jacklifear",
  "homepage": "https://github.com/earthdawn-vtt/fvtt-earthdawn4e",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/earthdawn-vtt/fvtt-earthdawn4e"
  },
  "bugs": {
    "url": "https://github.com/earthdawn-vtt/fvtt-earthdawn4e/issues"
  },
  "scripts": {
    "build": "npm run build:docs && build:packs && npm run build:css",
    "build:css": "gulp buildCSS",
    "build:docs": "typedoc --options typedoc.config.mjs",
    "build:packs": "npm run pullJSONtoLDB",
    "build:watch": "gulp",
    "lint:lang": "node tools/lint-json.mjs",
    "lint": "gulp lint",
    "lint:fix": "gulp lint --fix",
    "pushLDBtoJSON": "node ./tools/pushLDBtoJSON.mjs",
    "pullJSONtoLDB": "node ./tools/pullJSONtoLDB.mjs",
    "prepare": "husky",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@babel/eslint-parser": "^7.28.6",
    "@clean-jsdoc-theme/typedoc": "^5.0.2",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.11.1",
    "@ethaks/fvtt-quench": "^0.10.0",
    "@foundryvtt/foundryvtt-cli": "^1.1.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@stylistic/eslint-plugin-migrate": "^2.13.0",
    "@typhonjs-typedoc/typedoc-theme-dmt": "^0.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.16",
    "clean-jsdoc-theme": "^5.0.2",
    "cspell": "^9.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-typedoc": "^1.3.6",
    "fast-glob": "^3.3.3",
    "globals": "^15.15.0",
    "gulp": "^5.0.1",
    "gulp-eslint-new": "^1.9.1",
    "gulp-if": "^3.0.0",
    "gulp-less": "^5.0.0",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.5",
    "lint-staged": "^15.5.2",
    "markdownlint-cli": "^0.49.0",
    "merge-stream": "^2.0.0",
    "typedoc": "^0.28.19",
    "vitest": "^4.0.16",
    "yargs": "^17.7.2"
  },
  "overrides": {
    "glob-parent": "6.0.2"
  }
}
